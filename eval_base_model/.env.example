# 评估框架环境变量配置示例
# 将此文件复制为 .env 并填入实际值

# OpenAI 兼容 API 配置
EVAL_BASE_URL=https://your-api-endpoint/v1
EVAL_API_KEY=EMPTY
EVAL_MODEL_NAME=your-model-name

# 可选：配置文件路径（支持 JSON/YAML）
# EVAL_CONFIG_PATH=/path/to/eval_config.json

# 可选：默认并发配置
# EVAL_MAX_WORKERS=32
# EVAL_MAX_TOKENS=1024

# 可选：日志输出目录
# EVAL_LOG_DIR=./logs

# 可选：数据集根目录
# EVAL_DATASET_DIR=./datasets
